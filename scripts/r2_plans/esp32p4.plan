# Round-2 run plan, ESP32-P4 (scripts/r2_esp_queue.sh). Generated by
# scripts/r2_plans/make_plans.py. Fields: build|set|n.
# Peak stack and heap come with every row on the ESP32 boards, so there is no
# separate memory pass (c).
#
# (a) verification in every build; lattice ops at levels 3 and 1 (one core)
build-p4-r2-L3-B-dc0|verify|10
build-p4-r2-L3-B-dc0|lattice|10
build-p4-r2-L3-L-dc0|verify|10
build-p4-r2-L3-B-dc1|verify|10
build-p4-r2-L3-L-dc1|verify|10
build-p4-r2-L1-B-dc0|verify|10
build-p4-r2-L1-B-dc0|lattice|10
build-p4-r2-L1-L-dc0|verify|10
build-p4-r2-L1-B-dc1|verify|10
build-p4-r2-L1-L-dc1|verify|10
build-p4-r2-L2-B-dc0|verify|10
build-p4-r2-L2-L-dc0|verify|10
build-p4-r2-L2-B-dc1|verify|10
build-p4-r2-L2-L-dc1|verify|10
# (b) SHRINCS stateless signing, level 3, one core then two cores
build-p4-r2-L3-B-dc0|stateless|10
build-p4-r2-L3-L-dc0|stateless|10
build-p4-r2-L3-B-dc1|stateless|10
build-p4-r2-L3-L-dc1|stateless|10
# (d) round-1 job lists with the round-2 builds (reproducibility)
build-p4-r2-L3-B-dc0|r1|10
build-p4-r2-L3-L-dc0|r1|10
build-p4-r2-L3-B-dc1|r1|10
build-p4-r2-L3-L-dc1|r1|10
build-p4-r2-L1-B-dc0|r1|10
build-p4-r2-L1-L-dc0|r1|10
build-p4-r2-L1-B-dc1|r1|10
build-p4-r2-L1-L-dc1|r1|10
build-p4-r2-L2-B-dc0|r1|10
build-p4-r2-L2-L-dc0|r1|10
build-p4-r2-L2-B-dc1|r1|10
build-p4-r2-L2-L-dc1|r1|10
# (e) SHRINCS stateless signing, levels 2 and 1
build-p4-r2-L2-B-dc0|stateless|10
build-p4-r2-L2-L-dc0|stateless|10
build-p4-r2-L2-B-dc1|stateless|10
build-p4-r2-L2-L-dc1|stateless|10
build-p4-r2-L1-B-dc0|stateless|10
build-p4-r2-L1-L-dc0|stateless|10
build-p4-r2-L1-B-dc1|stateless|10
build-p4-r2-L1-L-dc1|stateless|10
