# Builds pq_bench from Blockstream's Jade scheme sources without modifying them: the
# sources are copied into the build directory, a stub jade_tasks.h is added, and
# slhdsa-c's sha2_256_compress() is renamed so a faster replacement can stand in for it.
#
#   make                          host build (x86), SHRINCS-B, OpenSSL SHA-256
#   make TARGET=armv6             Pi Zero build (run inside the seedsigner-raspi-lvgl
#                                 sdk-armv6 image; see run-armv6-build.sh)
#   make SHRINCS=L                SHRINCS-L variant
#   make COMPRESS=soft            plain-C SHA-256 compression for SLH-DSA
#   make EMU=esp                  emulate the ESP-IDF hardware driver's handling of
#                                 unstarted SHA-256 contexts (SHA-1), to match Jade
#
# Pi Zero speed options (the assembly needs TARGET=armv6). Each adds to the build
# directory name, and leaving them unset gives the builds above unchanged:
#
#   COMPRESS=asm      SLH-DSA compression calls OpenSSL 3.4.1's ARM assembly block
#                     function directly (shim/openssl-armv4/sha256-armv4.S, generated
#                     from OpenSSL's perlasm and assembled for ARMv6; same code as in
#                     libcrypto), instead of SHA256_Transform() in the shared libcrypto
#   COMPRESS=asmrev   the same assembly with OpenSSL's ARMv7 message loads (one word
#                     load plus rev per word, both ARMv6 instructions) instead of four
#                     byte loads
#   COMPRESS=asmrevbe asmrev, with SLH-DSA's compression served by a single-block copy
#                     of the assembly that takes slhdsa-c's big-endian state directly,
#                     so no C wrapper runs (shim/openssl-armv4/sha256-armv4-be.S,
#                     generated by make_be_variant.py)
#   SHA_API=direct    SHRINCS and XMSS hash through slhdsa-c's incremental SHA-256 over
#                     the COMPRESS function instead of OpenSSL's SHA256_Init/Update/Final
#   SHA_API=native    SHRINCS and XMSS hash through a native-word-order SHA-256 directly
#                     over the assembly block function (needs COMPRESS=asm, asmrev, or
#                     asmrevbe)
#   OPT=w1-w2-...     compiler and linker options, dash-separated words:
#                       o3      -O3 instead of -O2
#                       nossp   -fno-stack-protector (the SDK compiler enables
#                               -fstack-protector-strong by default)
#                       nopie   -fno-PIE -no-pie (the SDK compiler builds PIE by default)
#                       lto     link-time optimization across scheme and shim code
#                       static  link libcrypto statically
#                       fullstatic  link everything statically (-static), so calls
#                               into libc (memcpy, memset) skip the PLT
#                       noplt   -fno-plt (calls into shared libraries load the target
#                               from the GOT instead of going through a PLT stub)
#   make ... cbench   also build compress_bench (../common/compress_bench.c), the
#                     per-compression microbenchmark, against the same objects
#   make ... prof     also build pq_bench_prof: pq_bench plus a SIGPROF sampler
#                     (../common/sigprof.c); not for timing
#
# Round 2 (every build directory now starts with "r2-"; the round-1 directories under
# build/ were made by the earlier version of this Makefile and are left as they are):
#   - the lattice schemes are linked into every build: mldsa-native (pinned in
#     ../../third_party/mldsa-native, configured by ../common/lattice/pqb_mldsa_config.h,
#     built twice: default and MLD_CONFIG_REDUCE_RAM) and c-fn-dsa
#     (../../third_party/c-fn-dsa, integer floating-point emulation forced on every
#     target, including the x86 host, so the host reference runs the boards' code path)
#   - the verification vectors vectors/vectors-$(SHRINCS).bin are embedded when the file
#     exists (make it with a host build: pq_bench --write-vectors vectors/vectors-B.bin);
#     without it, the verify ops and the signing ops that load keys fail with an error
#   MEM=1     memory build: each op in a fresh thread with a painted stack, heap counted
#             through -Wl,--wrap=malloc (../common/mem_linux.c); for the memory pass, not
#             timing
#   COUNT=1   host attempt-counting build: an observe-only mldsa-native signing hook
#             fills the grind column with ML-DSA signing attempts; not for timing
#
# Round 4 (Pi Zero 2 W). Each option is off by default, and the builds above are
# unchanged by it:
#   TARGET=pi02w        Pi Zero 2 W build (run inside the seedsigner-raspi-lvgl sdk-pi02w
#                       image; see ../../scripts/r4_pi02w_build_all.sh). The image's
#                       compiler wrapper adds -mcpu=cortex-a53 -mfpu=neon-vfpv4
#                       -mfloat-abi=hard -marm to every compilation, as the sdk-armv6
#                       wrapper adds the ARM1176 flags. COMPRESS=asm, asmrev, and asmrevbe
#                       work here too.
#   ROUND=r4            first word of the build directory name (default r2)
#   COMPRESS=asmneon    OpenSSL 3.4.1's NEON block function (sha256_block_data_order_neon
#                       from the same generated file, extracted without the run-time
#                       capability check: shim/openssl-neon/sha256-neon.S) as
#                       pqb_sha256_blocks, and SLH-DSA's compression through the C wrapper
#                       around it (shim/sha256_compress_asm.c); needs TARGET=pi02w
#   COMPRESS=asmneonbe  the NEON block function as pqb_sha256_blocks, and SLH-DSA's
#                       compression served by a single-block copy of it that takes
#                       slhdsa-c's big-endian state directly (shim/openssl-neon/
#                       sha256-neon-be.S); both files are generated by
#                       shim/openssl-neon/make_neon_variants.py; needs TARGET=pi02w
#   DUAL_CORE=1         Blockstream's two-core code paths in slh_dsa.c and wots_c.c: the
#                       build copies of those two files lose their single-core define
#                       (as ../esp-idf/main/CMakeLists.txt does for PQB_DUAL_CORE), and
#                       the FreeRTOS calls they make run over POSIX threads, one new
#                       thread per task (shim_dualcore/freertos_pthread.c); directory name
#                       gains -dc1; not with MEM=1
#   DUAL_CORE=pool      as DUAL_CORE=1, but every task runs on one persistent worker
#                       thread (shim_dualcore/freertos_pthread_pool.c); directory name
#                       gains -dc1pool

# The shared benchmark sources (harness/common) and the pinned third-party code
COMMON := ../common
JADE_MAIN ?= ../../third_party/jade-hbs/main
MLDSA_DIR ?= ../../third_party/mldsa-native/mldsa
FNDSA_DIR ?= ../../third_party/c-fn-dsa
TARGET ?= host
SHRINCS ?= B
COMPRESS ?= openssl
EMU ?=
SHA_API ?=
OPT ?=
MEM ?=
COUNT ?=
DUAL_CORE ?=
ROUND ?= r2
VECTORS ?= vectors/vectors-$(SHRINCS).bin

BUILD := build/$(ROUND)-$(TARGET)-shrincs$(SHRINCS)-$(COMPRESS)$(if $(EMU),-emu$(EMU))$(if $(SHA_API),-api$(SHA_API))$(if $(OPT),-opt$(OPT))$(if $(DUAL_CORE),-dc1$(if $(filter pool,$(DUAL_CORE)),pool))$(if $(MEM),-mem)$(if $(COUNT),-count)
GEN := $(BUILD)/src

# ARM Linux targets: the Buildroot cross-compiler of the SDK image the build runs in
ARM_TARGETS := armv6 pi02w
ifneq ($(filter $(TARGET),$(ARM_TARGETS)),)
CC := /output/host/bin/arm-Buildroot-linux-gnueabihf-gcc
else
CC ?= gcc
endif

OPT_WORDS := $(subst -, ,$(OPT))
OPT_KNOWN := o3 nossp nopie lto static fullstatic noplt
ifneq ($(filter-out $(OPT_KNOWN),$(OPT_WORDS)),)
$(error unknown OPT word(s): $(filter-out $(OPT_KNOWN),$(OPT_WORDS)))
endif
OLEVEL := $(if $(filter o3,$(OPT_WORDS)),-O3,-O2)
OPT_CFLAGS := $(if $(filter nossp,$(OPT_WORDS)),-fno-stack-protector) \
	$(if $(filter nopie fullstatic,$(OPT_WORDS)),-fno-PIE) $(if $(filter lto,$(OPT_WORDS)),-flto) \
	$(if $(filter noplt,$(OPT_WORDS)),-fno-plt)
OPT_LDFLAGS := $(if $(filter lto,$(OPT_WORDS)),$(OLEVEL) $(OPT_CFLAGS)) \
	$(if $(filter nopie fullstatic,$(OPT_WORDS)),-no-pie) $(if $(filter fullstatic,$(OPT_WORDS)),-static)

SHIM_INC := $(if $(DUAL_CORE),-Ishim_dualcore) $(if $(SHA_API),-Ishim_$(SHA_API)) -Ishim
CFLAGS := $(OLEVEL) -std=gnu17 -Wall -Wno-deprecated-declarations -Wno-unused-function \
	-DSHRINCS_$(SHRINCS) $(SHIM_INC) -I$(GEN) -I$(COMMON) $(OPT_CFLAGS)
ifeq ($(EMU),esp)
CFLAGS += -DSHIM_EMULATE_ESP_UNSTARTED_SHA1
endif
comma := ,
LDLIBS := $(if $(filter static,$(OPT_WORDS)),-Wl$(comma)-Bstatic -lcrypto -Wl$(comma)-Bdynamic,-lcrypto) -lm

# Lattice libraries: their own include paths only, same optimization and safeguard flags
MLDSA_CFLAGS := $(OLEVEL) -std=gnu17 -Wall -Wno-unused-function $(OPT_CFLAGS) \
	-DMLD_CONFIG_FILE='"pqb_mldsa_config.h"' -I$(COMMON)/lattice -I$(MLDSA_DIR) \
	$(if $(COUNT),-DPQB_MLDSA_COUNT)
FNDSA_CFLAGS := $(OLEVEL) -std=gnu17 -w $(OPT_CFLAGS) -I$(FNDSA_DIR) \
	-DFNDSA_AVX2=0 -DFNDSA_SSE2=0 -DFNDSA_NEON=0 -DFNDSA_RV64D=0
FNDSA_SRCS := codec.c mq.c sha3.c sysrng.c util.c kgen.c kgen_fxp.c kgen_gauss.c \
	kgen_mp31.c kgen_ntru.c kgen_poly.c kgen_zint31.c sign.c sign_core.c sign_fpoly.c \
	sign_fpr.c sign_sampler.c vrfy.c
CFLAGS += -I$(FNDSA_DIR) $(if $(COUNT),-DPQB_MLDSA_COUNT)
ifneq ($(MEM),)
CFLAGS += -DPQB_MEM -pthread
LDLIBS += -pthread -Wl,--wrap=malloc,--wrap=free,--wrap=calloc,--wrap=realloc
endif
ifneq ($(DUAL_CORE),)
ifneq ($(MEM),)
$(error DUAL_CORE=1 and MEM=1 together are not supported: the memory build measures one thread)
endif
CFLAGS += -pthread
LDLIBS += -pthread
DUAL_SRCS := shim_dualcore/freertos_pthread$(if $(filter pool,$(DUAL_CORE)),_pool).c
else
DUAL_SRCS :=
endif
ifneq ($(wildcard $(VECTORS)),)
CFLAGS += -DPQB_HAVE_VECTORS
VEC_OBJ := $(BUILD)/obj/common/vectors_blob.o
else
VEC_OBJ :=
endif

ifneq ($(filter asm asmrev asmrevbe,$(COMPRESS)),)
ifeq ($(filter $(TARGET),$(ARM_TARGETS)),)
$(error COMPRESS=$(COMPRESS) is ARM assembly; it needs TARGET=armv6 or pi02w)
endif
ASM_OBJ := $(BUILD)/obj/linux/shim/openssl-armv4/sha256-armv4.o
ASM_FLAGS := -Wa,--noexecstack -Ishim/openssl-armv4 \
	$(if $(filter asmrev asmrevbe,$(COMPRESS)),-D__ARM_ARCH__=7)
ASM_DEFS := $(ASM_FLAGS) -Dsha256_block_data_order=pqb_sha256_blocks
ifeq ($(COMPRESS),asmrevbe)
COMPRESS_SRC :=
ASM_BE_OBJ := $(BUILD)/obj/linux/shim/openssl-armv4/sha256-armv4-be.o
else
COMPRESS_SRC := shim/sha256_compress_asm.c
ASM_BE_OBJ :=
endif
else ifneq ($(filter asmneon asmneonbe,$(COMPRESS)),)
ifneq ($(TARGET),pi02w)
$(error COMPRESS=$(COMPRESS) is NEON assembly; it needs TARGET=pi02w)
endif
ASM_OBJ := $(BUILD)/obj/linux/shim/openssl-neon/sha256-neon.o
ifeq ($(COMPRESS),asmneonbe)
COMPRESS_SRC :=
ASM_BE_OBJ := $(BUILD)/obj/linux/shim/openssl-neon/sha256-neon-be.o
else
COMPRESS_SRC := shim/sha256_compress_asm.c
ASM_BE_OBJ :=
endif
else
COMPRESS_SRC := shim/sha256_compress_$(COMPRESS).c
ASM_OBJ :=
ASM_BE_OBJ :=
endif

ifeq ($(SHA_API),)
API_SRCS := shim/mbedtls_shim.c
else ifeq ($(SHA_API),direct)
API_SRCS := shim/sha256_ctx_direct.c shim/sha512_openssl.c
else ifeq ($(SHA_API),native)
ifeq ($(ASM_OBJ),)
$(error SHA_API=native needs COMPRESS=asm, asmrev, asmrevbe, asmneon, or asmneonbe)
endif
API_SRCS := shim/sha256_ctx_native.c shim/sha512_openssl.c
else
$(error unknown SHA_API: $(SHA_API))
endif
ifneq ($(and $(SHA_API),$(EMU)),)
$(error EMU applies to the OpenSSL-backed API only; leave SHA_API unset)
endif

# The files third_party/jade-hbs/main/amalgamated.c compiles for these schemes
SCHEME_SRCS := \
	shrincs/address.c shrincs/hash.c shrincs/pors_fp.c shrincs/shrincs.c shrincs/uxmss.c \
	shrincs/wots_c.c shrincs/xmss.c \
	slh_dsa/sha2_256.c slh_dsa/sha2_512.c slh_dsa/sha3_api.c slh_dsa/sha3_f1600.c \
	slh_dsa/slh_dsa.c slh_dsa/slh_prehash.c slh_dsa/slh_sha2.c slh_dsa/slh_shake.c \
	xmss/fips202.c xmss/hash_address.c xmss/hash.c xmss/params.c xmss/randombytes.c \
	xmss/utils.c xmss/wots.c xmss/xmss_commons.c xmss/xmss_core.c xmss/xmss.c
COMMON_SRCS := main.c common.c op_slh.c op_shrincs.c op_xmss.c op_mldsa.c op_fndsa.c \
	vectors.c gen_vectors.c $(if $(MEM),mem_linux.c)
LOCAL_SRCS := $(COMPRESS_SRC) $(API_SRCS) $(DUAL_SRCS)
LATTICE_OBJS := $(BUILD)/obj/lattice/pqb_mldsa_all.o $(BUILD)/obj/lattice/pqb_mldsa_all_lowram.o \
	$(patsubst %.c,$(BUILD)/obj/fndsa/%.o,$(FNDSA_SRCS))

OBJS := $(patsubst %.c,$(BUILD)/obj/%.o,$(SCHEME_SRCS)) \
	$(patsubst %.c,$(BUILD)/obj/common/%.o,$(COMMON_SRCS)) \
	$(patsubst %.c,$(BUILD)/obj/linux/%.o,$(LOCAL_SRCS)) $(ASM_OBJ) $(ASM_BE_OBJ) \
	$(LATTICE_OBJS) $(VEC_OBJ)
CB_OBJS := $(filter-out $(BUILD)/obj/common/main.o,$(OBJS)) \
	$(BUILD)/obj/common/compress_bench.o

.PHONY: all clean cbench prof
all: $(BUILD)/pq_bench
cbench: $(BUILD)/pq_bench $(BUILD)/compress_bench
prof: $(BUILD)/pq_bench $(BUILD)/pq_bench_prof

$(GEN)/.stamp: Makefile $(if $(DUAL_CORE),shim_dualcore/jade_tasks.h)
	rm -rf $(GEN)
	mkdir -p $(GEN)
	cp -r $(JADE_MAIN)/shrincs $(JADE_MAIN)/slh_dsa $(JADE_MAIN)/xmss $(GEN)/
ifeq ($(DUAL_CORE),)
	printf '/* stub: dual-core paths are compiled out */\n' > $(GEN)/jade_tasks.h
else
	cp shim_dualcore/jade_tasks.h $(GEN)/jade_tasks.h
	sed -i 's|^#define CONFIG_FREERTOS_UNICORE 1$$|/* two-core build: single-core define removed */|' \
		$(GEN)/slh_dsa/slh_dsa.c $(GEN)/shrincs/wots_c.c
	! grep -q 'define CONFIG_FREERTOS_UNICORE' $(GEN)/slh_dsa/slh_dsa.c $(GEN)/shrincs/wots_c.c
	grep -q '^/\* two-core build: single-core define removed \*/$$' $(GEN)/slh_dsa/slh_dsa.c
	grep -q '^/\* two-core build: single-core define removed \*/$$' $(GEN)/shrincs/wots_c.c
endif
	sed -i 's/^void sha2_256_compress(void \*v)$$/void sha2_256_compress_soft(void *v)/' \
		$(GEN)/slh_dsa/sha2_256.c
	grep -q '^void sha2_256_compress_soft(void \*v)$$' $(GEN)/slh_dsa/sha2_256.c
	touch $@

# Scheme sources include the shim headers (mbedtls/sha256.h, which holds inline code for
# SHA_API=native), so their objects depend on those headers too.
SHIM_HDRS := $(wildcard shim/*.h shim/*/*.h shim_*/*/*.h)

$(BUILD)/obj/%.o: $(GEN)/.stamp $(SHIM_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $(GEN)/$*.c -o $@

$(BUILD)/obj/common/%.o: $(COMMON)/%.c $(GEN)/.stamp $(wildcard $(COMMON)/*.h) $(SHIM_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/obj/linux/%.o: %.c $(GEN)/.stamp $(wildcard $(COMMON)/*.h) $(SHIM_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/obj/lattice/%.o: $(COMMON)/lattice/%.c $(COMMON)/lattice/pqb_mldsa_config.h \
		$(COMMON)/lattice/pqb_mldsa_all.c
	@mkdir -p $(dir $@)
	$(CC) $(MLDSA_CFLAGS) -c $< -o $@

$(BUILD)/obj/fndsa/%.o: $(FNDSA_DIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(FNDSA_CFLAGS) -c $< -o $@

# vectors.o is compiled with -DPQB_HAVE_VECTORS only once the blob exists
$(BUILD)/obj/common/vectors.o: $(wildcard $(VECTORS))

$(BUILD)/obj/common/vectors_blob.o: $(COMMON)/vectors_blob.c $(VECTORS)
	@mkdir -p $(dir $@)
	$(CC) -DPQB_VECTORS_FILE='"$(abspath $(VECTORS))"' -c $< -o $@

$(BUILD)/obj/linux/shim/openssl-armv4/sha256-armv4.o: shim/openssl-armv4/sha256-armv4.S \
		shim/openssl-armv4/arm_arch.h Makefile
	@mkdir -p $(dir $@)
	$(CC) $(ASM_DEFS) -c $< -o $@

$(BUILD)/obj/linux/shim/openssl-armv4/sha256-armv4-be.o: shim/openssl-armv4/sha256-armv4-be.S \
		shim/openssl-armv4/arm_arch.h Makefile
	@mkdir -p $(dir $@)
	$(CC) $(ASM_FLAGS) -Dsha256_block_data_order=sha2_256_compress -c $< -o $@

$(BUILD)/obj/linux/shim/openssl-neon/sha256-neon.o: shim/openssl-neon/sha256-neon.S Makefile
	@mkdir -p $(dir $@)
	$(CC) -Wa,--noexecstack -Dsha256_block_data_order_neon=pqb_sha256_blocks -c $< -o $@

$(BUILD)/obj/linux/shim/openssl-neon/sha256-neon-be.o: shim/openssl-neon/sha256-neon-be.S \
		Makefile
	@mkdir -p $(dir $@)
	$(CC) -Wa,--noexecstack -Dsha256_block_data_order_neon=sha2_256_compress -c $< -o $@

$(BUILD)/pq_bench: $(OBJS)
	$(CC) $(OPT_LDFLAGS) -o $@ $^ $(LDLIBS)

$(BUILD)/compress_bench: $(CB_OBJS)
	$(CC) $(OPT_LDFLAGS) -o $@ $^ $(LDLIBS)

$(BUILD)/pq_bench_prof: $(OBJS) $(BUILD)/obj/common/sigprof.o
	$(CC) $(OPT_LDFLAGS) -o $@ $^ $(LDLIBS)

clean:
	rm -rf build
